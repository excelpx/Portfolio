# =========================================================
# BASE PHP - FRANKENPHP
# =========================================================
FROM dunglas/frankenphp:php8.3-bookworm AS php-base

WORKDIR /app

# PHP extensions untuk Laravel + MongoDB
RUN install-php-extensions \
    mongodb \
    mbstring \
    bcmath \
    intl \
    zip \
    opcache

# =========================================================
# COMPOSER DEPENDENCIES
# =========================================================
FROM php-base AS dependencies

# Composer hanya digunakan saat build
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts

# =========================================================
# FRONTEND BUILD
# =========================================================
FROM node:22-bookworm AS frontend

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm ci

COPY resources ./resources
COPY public ./public
COPY vite.config.js ./

RUN npm run build

# =========================================================
# PRODUCTION
# =========================================================
FROM php-base

WORKDIR /app

# Laravel dependencies
COPY --from=dependencies /app/vendor ./vendor

# Source code Laravel
COPY . .

# Hasil build Vite
COPY --from=frontend /app/public/build ./public/build

# =========================================================
# LARAVEL DIRECTORIES
# =========================================================
RUN mkdir -p \
    storage/framework/cache \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

# =========================================================
# VERCEL
# =========================================================
ENV SERVER_NAME=:80

EXPOSE 80

# Jalankan Laravel menggunakan FrankenPHP
CMD ["sh", "-c", "frankenphp php-server -r public/ --listen 0.0.0.0:${PORT:-80}"]