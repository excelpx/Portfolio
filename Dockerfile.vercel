FROM dunglas/frankenphp:php8.3-bookworm AS php-base

WORKDIR /app

# PHP extensions yang dibutuhkan Laravel + MongoDB
RUN install-php-extensions \
    mongodb \
    mbstring \
    bcmath \
    intl \
    zip \
    opcache

# Composer dependencies
FROM php-base AS dependencies

COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts

# Frontend build
FROM node:22-bookworm AS frontend

WORKDIR /app

COPY package.json package-lock.json* ./

RUN npm ci

COPY resources ./resources
COPY public ./public
COPY vite.config.js ./

RUN npm run build

# Production image
FROM php-base

WORKDIR /app

# Composer dependencies
COPY --from=dependencies /app/vendor ./vendor

# Application source
COPY . .

# Vite build
COPY --from=frontend /app/public/build ./public/build

# Laravel directories
RUN mkdir -p \
    storage/framework/cache \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

# Clear Laravel cached configuration
RUN php artisan optimize:clear

# Vercel container listens on PORT
ENV SERVER_NAME=:80

EXPOSE 80

CMD ["sh", "-c", "frankenphp php-server -r public/ --listen 0.0.0.0:${PORT:-80}"]