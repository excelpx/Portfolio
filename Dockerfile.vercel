# =========================================================
# PHP BASE
# =========================================================
FROM dunglas/frankenphp:php8.3-bookworm AS php-base

WORKDIR /app

# PHP extensions Laravel + MongoDB
RUN install-php-extensions \
    mongodb \
    mbstring \
    bcmath \
    intl \
    zip \
    opcache

# =========================================================
# COMPOSER
# =========================================================
FROM php-base AS dependencies

# Ambil Composer resmi
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts

# =========================================================
# FRONTEND
# =========================================================
FROM node:22-bookworm AS frontend

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm ci

COPY resources ./resources
COPY public ./public
COPY vite.config.js ./

RUN npm run build

# =========================================================
# PRODUCTION
# =========================================================
FROM php-base

WORKDIR /app

# Composer binary
COPY --from=dependencies /usr/bin/composer /usr/bin/composer

# Laravel dependencies
COPY --from=dependencies /app/vendor ./vendor

# Project
COPY . .

# Vite build
COPY --from=frontend /app/public/build ./public/build

# Laravel writable directories
RUN mkdir -p \
    storage/framework/cache \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

# Vercel container
ENV SERVER_NAME=:80

EXPOSE 80
# Production deployment
CMD ["sh", "-c", "frankenphp php-server -r public/ --listen 0.0.0.0:${PORT:-80}"]